# Required
ND_URL=http://navidrome.local:4533
ND_USER=changeme
ND_PASS=changeme

# Optional
# STATE_DIR=./data          # persisted speaker group, follow-on preference
# PORT=8000                 # with Docker host networking this is a port on the host itself;
#                           # if something already uses 8000 ("Address already in use"), pick another
#                           # (avoid 8123 - that's Home Assistant's own default port)
